# Copy this file to `.env` (or set these vars in your host dashboard).
# NEVER commit real keys — `.env` is gitignored.

# Supabase project URL, e.g. https://abcxyz.supabase.co
VITE_SUPABASE_URL=

# Supabase "anon" / "public" API key — safe to use in the browser
VITE_SUPABASE_ANON_KEY=

# QR Tracking Supabase project (Different project/user)
VITE_QR_SUPABASE_URL=
VITE_QR_SUPABASE_KEY=